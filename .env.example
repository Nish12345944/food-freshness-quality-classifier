# FoodFresh AI — environment variables (names only; fill in real values locally, never commit them)

# Flask secret key for session signing (REQUIRED in production)
SECRET_KEY=

# Database — PostgreSQL connection string in production.
# Leave unset to use local SQLite (instance/users.db).
DATABASE_URL=

# ML model artifact path and version label
MODEL_PATH=models/food_freshness.pt
MODEL_VERSION=1.0.0
# HTTPS URL of the trained model artifact (e.g. Hugging Face Hub 'resolve/main'
# link). Leave empty for local dev; set once a real trained model exists.
MODEL_URL=
# "1" (default) fails the Render build when no model is present; "0" allows a
# degraded model-less boot (local dev / temporary demo only).
REQUIRE_MODEL=1

# Confidence thresholds for High / Medium levels (Low is everything below)
CONFIDENCE_HIGH=0.70
CONFIDENCE_MEDIUM=0.50

# Upload limits
MAX_UPLOAD_MB=16
MAX_BATCH_SIZE=10

# Email reports (optional — email fails gracefully when unconfigured)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=

# Application version exposed via /health and the API
APP_VERSION=1.0.0