# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# Databases
*.db
*.sqlite
*.sqlite3
instance/

# User data / generated content
uploads/
reports/
static/uploads/
static/reports/
static/gradcam/
static/profiles/*
!static/profiles/default.png

# Training dataset (download/prepare locally; do not commit)
data/

# Model artifacts (train locally; do not commit large binaries)
models/*.pt
models/*.pth
*.onnx
*.h5

# Testing / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build / packaging
build/
dist/
*.egg-info/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Note: requirements.txt, Procfile, render.yaml, build.sh, runtime.txt,
# wsgi.py and the app/ package are required for deployment — never ignore them.